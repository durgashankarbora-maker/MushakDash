        </div>
    </div>

    <!-- VICTORY -->
    <div class="overlay hidden" id="victory">
        <div class="panel">
            <h2>🎊 FESTIVAL VICTORY! 🎊</h2>
            <p>
                Wonderful! Mushak completed all 5 festival levels.
            </p>
            <p id="victoryScore"></p>
            <button id="victoryBtn">PLAY AGAIN</button>
        </div>
    </div>

</div>

<script>
/* =========================================================
   MUSHAK DASH V5.2
   Stable Falling Object Engine
========================================================= */

const gameShell = document.getElementById("gameShell");
const playArea = document.getElementById("playArea");
const player = document.getElementById("player");

const scoreEl = document.getElementById("score");
const livesEl = document.getElementById("lives");
const levelEl = document.getElementById("level");
const bestEl = document.getElementById("best");
const shieldStatusEl = document.getElementById("shieldStatus");
const progressBar = document.getElementById("progressBar");

const startScreen = document.getElementById("startScreen");
const pauseScreen = document.getElementById("pauseScreen");
const levelComplete = document.getElementById("levelComplete");
const gameOver = document.getElementById("gameOver");
const victory = document.getElementById("victory");

const countdown = document.getElementById("countdown");

const startBtn = document.getElementById("startBtn");
const pauseBtn = document.getElementById("pauseBtn");
const soundBtn = document.getElementById("soundBtn");
const resumeBtn = document.getElementById("resumeBtn");
const nextLevelBtn = document.getElementById("nextLevelBtn");
const restartBtn = document.getElementById("restartBtn");
const victoryBtn = document.getElementById("victoryBtn");

const leftBtn = document.getElementById("leftBtn");
const rightBtn = document.getElementById("rightBtn");

/* GAME STATE */
let score = 0;
let lives = 3;
let level = 1;
let playerX = 50;
let shield = false;

let running = false;
let paused = false;
let countdownRunning = false;

let objects = [];
let lastTime = 0;
let spawnTimer = 0;
let animationId = null;

let soundEnabled = true;
let audioContext = null;
let musicTimer = null;

/* BEST SCORE */
let bestScore = Number(localStorage.getItem("mushakDashBest") || 0);
bestEl.textContent = bestScore;

/* LEVEL DATA */
const levels = {
    1: {
        target: 100,
        speed: 0.18,
        spawn: 850
    },
    2: {
        target: 250,
        speed: 0.23,
        spawn: 760
    },
    3: {
        target: 450,
        speed: 0.28,
        spawn: 680
    },
    4: {
        target: 700,
        speed: 0.34,
        spawn: 600
    },
    5: {
        target: 1000,
        speed: 0.40,
        spawn: 530
    }
};

const currentLevel = () => levels[level];

/* ITEM TYPES */
const items = [
    { emoji: "🪔", points: 15 },
    { emoji: "🌸", points: 10 },
    { emoji: "🍬", points: 20 },
    { emoji: "🪷", points: 15 },
    { emoji: "✨", points: 25 }
];

const obstacles = [
    "🪨",
    "🟣",
    "🔴"
];

/* =========================================================
   AUDIO
========================================================= */

function beep(freq, duration = 0.08, type = "sine") {
    if (!soundEnabled) return;

    try {
        if (!audioContext) {
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }

        const oscillator = audioContext.createOscillator();
        const gain = audioContext.createGain();

        oscillator.type = type;
        oscillator.frequency.value = freq;

        gain.gain.setValueAtTime(0.08, audioContext.currentTime);
        gain.gain.exponentialRampToValueAtTime(
            0.001,
            audioContext.currentTime + duration
        );

        oscillator.connect(gain);
        gain.connect(audioContext.destination);

        oscillator.start();
        oscillator.stop(audioContext.currentTime + duration);
    } catch (e) {}
}

function startMusic() {
    if (!soundEnabled || musicTimer) return;

    const notes = [261, 329, 392, 523, 392, 329];
    let i = 0;

    musicTimer = setInterval(() => {
        if (running && !paused) {
            beep(notes[i % notes.length], 0.12, "triangle");
            i++;
        }
    }, 700);
}

function stopMusic() {
    if (musicTimer) {
        clearInterval(musicTimer);
        musicTimer = null;
    }
}

soundBtn.addEventListener("click", () => {
    soundEnabled = !soundEnabled;
    soundBtn.textContent = soundEnabled ? "🔊" : "🔇";

    if (soundEnabled) {
        beep(500);
        startMusic();
    } else {
        stopMusic();
    }
});

/* =========================================================
   UI
========================================================= */

function updateHUD() {
    scoreEl.textContent = score;
    livesEl.textContent = lives;
    levelEl.textContent = level;
    bestEl.textContent = bestScore;
    shieldStatusEl.textContent = shield ? "YES" : "No";

    const target = currentLevel().target;
    const previousTarget = level === 1 ? 0 : levels[level - 1].target;
    const progress =
        ((score - previousTarget) /
        (target - previousTarget)) * 100;

    progressBar.style.width =
        Math.max(0, Math.min(100, progress)) + "%";
}

function hideAllScreens() {
    startScreen.classList.add("hidden");
    pauseScreen.classList.add("hidden");
    levelComplete.classList.add("hidden");
    gameOver.classList.add("hidden");
    victory.classList.add("hidden");
}

/* =========================================================
   RESET
========================================================= */

function resetGame() {
    score = 0;
    lives = 3;
    level = 1;
    playerX = 50;
    shield = false;

    running = false;
    paused = false;
    countdownRunning = false;

    spawnTimer = 0;
    lastTime = performance.now();

    removeAllObjects();

    player.style.left = "50%";
    player.classList.remove("shielded");

    updateHUD();
}

/* =========================================================
   OBJECT ENGINE
========================================================= */

function removeAllObjects() {
    for (const object of objects) {
        if (object.el && object.el.parentNode) {
            object.el.remove();
        }
    }

    objects = [];
}

function createObject() {

    const isObstacle = Math.random() < 0.27;

    const el = document.createElement("div");
    el.className =
        "fallingObject " +
        (isObstacle ? "obstacle" : "item");

    let data;

    if (isObstacle) {
        data = {
            emoji:
                obstacles[
                    Math.floor(Math.random() * obstacles.length)
                ],
            points: 0
        };
    } else {
        data =
            items[
                Math.floor(Math.random() * items.length)
            ];
    }

    el.textContent = data.emoji;

    /*
        IMPORTANT V5.2 FIX:
        We store falling position in PIXELS.
        CSS transform is used for movement.
        This avoids the old top/y coordinate problem.
    */

    const areaWidth = playArea.clientWidth;

    const x =
        8 +
        Math.random() * 84;

    const y = -65;

    el.style.left = x + "%";
    el.style.transform =
        "translate3d(-50%, " + y + "px, 0)";

    playArea.appendChild(el);

    const object = {
        el: el,
        x: x,
        y: y,
        obstacle: isObstacle,
        points: data.points,
        width: 52,
        height: 52
    };

    objects.push(object);
}

function createShield() {

    const el = document.createElement("div");

    el.className = "fallingObject shield";
    el.textContent = "🛡️";

    const x =
        10 +
        Math.random() * 80;

    const y = -65;

    el.style.left = x + "%";
    el.style.transform =
        "translate3d(-50%, " + y + "px, 0)";

    playArea.appendChild(el);

    objects.push({
        el: el,
        x: x,
        y: y,
        obstacle: false,
        shieldItem: true,
        points: 0,
        width: 52,
        height: 52
    });
}

/* =========================================================
   COLLISION
========================================================= */

function checkCollision(object) {

    const playerY =
        playArea.clientHeight -
        25 -
        31;

    const horizontalDistance =
        Math.abs(object.x - playerX);

    const verticalDistance =
        Math.abs(object.y - playerY);

    return (
        horizontalDistance < 8 &&
        verticalDistance < 50
    );
}

function processCollision(object) {

    if (object.shieldItem) {

        shield = true;
        player.classList.add("shielded");

        score += 30;

        showFloatScore(
            object.x,
            object.y,
            "🛡️ +30"
        );

        createParticles(object.x, object.y);
        beep(700, .15, "triangle");

        updateHUD();
        return;
    }

    if (object.obstacle) {

        if (shield) {

            shield = false;
            player.classList.remove("shielded");

            showFloatScore(
                object.x,
                object.y,
                "🛡️ BLOCKED!"
            );

            createParticles(object.x, object.y);
            beep(850, .15, "square");

        } else {

            lives--;

            showFloatScore(
                object.x,
                object.y,
                "💥 -1 LIFE"
            );

            createParticles(object.x, object.y);
            beep(120, .25, "sawtooth");

            if (lives <= 0) {
                endGame();
                return;
            }
        }

        updateHUD();
        return;
    }

    score += object.points;

    showFloatScore(
        object.x,
        object.y,
        "+" + object.points
    );

    createParticles(object.x, object.y);

    beep(550 + object.points * 8, .1, "sine");

    updateHUD();

    checkLevel();
}

/* =========================================================
   FALLING LOOP
========================================================= */

function gameLoop(timestamp) {

    animationId =
        requestAnimationFrame(gameLoop);

    if (!running || paused || countdownRunning) {
        lastTime = timestamp;
        return;
    }

    let delta =
        timestamp - lastTime;

    lastTime = timestamp;

    /*
        Prevent huge jumps if browser tab was inactive.
    */
    delta = Math.min(delta, 50);

    spawnTimer += delta;

    if (spawnTimer >= currentLevel().spawn) {

        createObject();

        spawnTimer = 0;

        /*
            Small chance for shield.
        */
        if (Math.random() < 0.055) {
            createShield();
        }
    }

    const speed =
        currentLevel().speed;

    const areaHeight =
        playArea.clientHeight;

    for (let i = objects.length - 1; i >= 0; i--) {

        const object = objects[i];

        /*
            V5.2 STABLE MOVEMENT:
            y is always increased by elapsed time.
        */
        object.y +=
            speed * delta;

        object.el.style.transform =
            "translate3d(-50%, " +
            object.y +
            "px, 0)";

        /*
            Collision near player.
        */
        if (checkCollision(object)) {

            processCollision(object);

            if (object.el.parentNode) {
                object.el.remove();
            }

            objects.splice(i, 1);

            continue;
        }

        /*
            Remove ONLY after object has completely
            passed the bottom of the play area.
        */
        if (
            object.y >
            areaHeight + 70
        ) {

            if (object.el.parentNode) {
                object.el.remove();
            }

            objects.splice(i, 1);
        }
    }

    /*
        Passive survival score.
    */
    if (
        Math.floor(timestamp / 1000) !==
        Math.floor((timestamp - delta) / 1000)
    ) {

        score += 2;

        updateHUD();

        checkLevel();
    }
}

/* =========================================================
   LEVEL SYSTEM
========================================================= */

function checkLevel() {

    if (!running) return;

    const target =
        currentLevel().target;

    if (score < target) return;

    running = false;

    removeAllObjects();

    if (level >= 5) {

        victoryScore.textContent =
            "🏆 Final Score: " + score;

        if (score > bestScore) {
            bestScore = score;
            localStorage.setItem(
                "mushakDashBest",
                bestScore
            );
        }

        updateHUD();

        victory.classList.remove("hidden");

        beep(523,.2);
        setTimeout(() => beep(659,.2),180);
        setTimeout(() => beep(784,.3),360);

        return;
    }

    levelCompleteText.textContent =
        "You reached Level " +
        level +
        " with " +
        score +
        " points!";

    levelComplete.classList.remove("hidden");

    beep(523,.15);
    setTimeout(() => beep(659,.15),150);
}

/* =========================================================
   COUNTDOWN
========================================================= */

function runCountdown(callback) {

    countdownRunning = true;
    countdown.style.display = "flex";

    const sequence = ["3", "2", "1", "GO!"];
    let index = 0;

    function next() {

        if (index >= sequence.length) {

            countdown.style.display = "none";
            countdownRunning = false;

            callback();
            return;
        }

        countdown.textContent =
            sequence[index];

        beep(
            index === 3 ? 800 : 500,
            .12
        );

        index++;

        setTimeout(next, 700);
    }

    next();
}

/* =========================================================
   START GAME
========================================================= */

function startGame() {

    resetGame();

    hideAllScreens();

    runCountdown(() => {

        running = true;
        paused = false;
        lastTime = performance.now();
        spawnTimer = 0;

        startMusic();
    });
}

/* =========================================================
   NEXT LEVEL
========================================================= */

function nextLevel() {

    level++;

    shield = false;
    player.classList.remove("shielded");

    removeAllObjects();

    levelComplete.classList.add("hidden");

    updateHUD();

    runCountdown(() => {

        running = true;
        paused = false;
        lastTime = performance.now();
        spawnTimer = 0;

        startMusic();
    });
}

/* =========================================================
   GAME OVER
========================================================= */

function endGame() {

    running = false;
    paused = false;

    removeAllObjects();
    stopMusic();

    if (score > bestScore) {

        bestScore = score;

        localStorage.setItem(
            "mushakDashBest",
            bestScore
        );
    }

    gameOverText.textContent =
        "Score: " +
        score +
        " | Level: " +
        level +
        " | Best: " +
        bestScore;

    updateHUD();

    gameOver.classList.remove("hidden");

    beep(160,.4,"sawtooth");
}

/* =========================================================
   PAUSE
========================================================= */

function togglePause() {

    if (!running) return;

    paused = true;

    pauseScreen.classList.remove("hidden");

    stopMusic();
}

function resumeGame() {

    pauseScreen.classList.add("hidden");

    paused = false;

    lastTime = performance.now();

    startMusic();
}

/* =========================================================
   PLAYER MOVEMENT
========================================================= */

function movePlayer(direction) {

    if (!running || paused) return;

    playerX += direction * 7;

    playerX =
        Math.max(
            8,
            Math.min(92, playerX)
        );

    player.style.left =
        playerX + "%";
}

/* KEYBOARD */
document.addEventListener("keydown", (event) => {

    if (
        event.key === "ArrowLeft" ||
        event.key.toLowerCase() === "a"
    ) {
        movePlayer(-1);
    }

    if (
        event.key === "ArrowRight" ||
        event.key.toLowerCase() === "d"
    ) {
        movePlayer(1);
    }

    if (
        event.key === " " ||
        event.key.toLowerCase() === "p"
    ) {

        if (running && !paused) {
            togglePause();
        }
    }
});

/* MOBILE / MOUSE BUTTONS */
leftBtn.addEventListener("pointerdown", () => {
    movePlayer(-1);
});

rightBtn.addEventListener("pointerdown", () => {
    movePlayer(1);
});

/* TOUCH SCREEN */
playArea.addEventListener(
    "touchstart",
    handleTouch,
    { passive: true }
);

playArea.addEventListener(
    "touchmove",
    handleTouch,
    { passive: true }
);

function handleTouch(event) {

    if (!running || paused) return;

    const touch =
        event.touches[0];

    const rect =
        playArea.getBoundingClientRect();

    const x =
        touch.clientX -
        rect.left;

    const percent =
        (x / rect.width) * 100;

    playerX =
        Math.max(
            8,
            Math.min(92, percent)
        );

    player.style.left =
        playerX + "%";
}

/* =========================================================
   EFFECTS
========================================================= */

function showFloatScore(
    x,
    y,
    text
) {

    const el =
        document.createElement("div");

    el.className = "floatScore";
    el.textContent = text;

    el.style.left =
        x + "%";

    el.style.top =
        Math.max(10, y) + "px";

    playArea.appendChild(el);

    setTimeout(() => {
        el.remove();
    }, 800);
}

function createParticles(
    x,
    y
) {

    for (let i = 0; i < 8; i++) {

        const particle =
            document.createElement("div");

        particle.className =
            "particle";

        particle.style.left =
            x + "%";

        particle.style.top =
            y + "px";

        particle.style.setProperty(
            "--dx",
            ((Math.random() - .5) * 100) + "px"
        );

        particle.style.setProperty(
            "--dy",
            ((Math.random() - .5) * 100) + "px"
        );

        playArea.appendChild(particle);

        setTimeout(() => {
            particle.remove();
        }, 700);
    }
}

/* =========================================================
   BUTTON EVENTS
========================================================= */

startBtn.addEventListener(
    "click",
    startGame
);

restartBtn.addEventListener(
    "click",
    startGame
);

victoryBtn.addEventListener(
    "click",
    startGame
);

nextLevelBtn.addEventListener(
    "click",
    nextLevel
);

pauseBtn.addEventListener(
    "click",
    togglePause
);

resumeBtn.addEventListener(
    "click",
    resumeGame
);

/* =========================================================
   INITIALIZE V5.2
========================================================= */

resetGame();

hideAllScreens();

startScreen.classList.remove("hidden");

pauseBtn.style.display = "none";

animationId =
    requestAnimationFrame(gameLoop);

/*
    Show pause button only during gameplay.
*/
setInterval(() => {

    pauseBtn.style.display =
        running
            ? "block"
            : "none";

}, 200);

/* Initial HUD */
updateHUD();

</script>


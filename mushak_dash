    <!-- START -->
    <div class="overlay" id="startScreen">
        <div class="panel">
            <h2>🪔 Mushak Dash</h2>
            <p>
                Help Mushak travel through the beautiful
                Ganesh festival night!
            </p>
            <p>
                ⭐ Collect festival items<br>
                🛡️ Collect shields<br>
                ⚠️ Avoid obstacles
            </p>

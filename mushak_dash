<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mushak Dash V5.2</title>

<style>
* {
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
}

html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial, sans-serif;
    background: #120b2e;
}

body {
    display: flex;
    justify-content: center;
    align-items: center;
}

#gameShell {
    position: relative;
    width: min(100vw, 900px);
    height: min(100vh, 700px);
    overflow: hidden;
    background:
        radial-gradient(circle at 50% 20%, #54358f 0%, #211348 42%, #0d0820 100%);
    border: 3px solid #f5c542;
    box-shadow: 0 0 30px rgba(245,197,66,.45);
}

/* SKY */
.sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
}

.moon {
    position: absolute;
    top: 45px;
    right: 55px;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #fff2ad;
    box-shadow: 0 0 25px #ffe68a;
}

.star {
    position: absolute;
    color: #fff5bd;
    animation: twinkle 1.8s infinite alternate;
}

@keyframes twinkle {
    from { opacity: .25; transform: scale(.8); }
    to { opacity: 1; transform: scale(1.2); }
}

.cloud {
    position: absolute;
    color: rgba(255,255,255,.14);
    font-size: 55px;
}

/* FESTIVAL HEADER */
#festivalHeader {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 95px;
    z-index: 10;
    text-align: center;
    padding-top: 10px;
    background: linear-gradient(
        to bottom,
        rgba(15,7,40,.85),
        rgba(15,7,40,.15)
    );
}

#festivalHeader h1 {
    margin: 0;
    color: #ffd75a;
    font-size: clamp(25px, 5vw, 44px);
    text-shadow: 0 0 12px rgba(255,215,90,.8);
}

#festivalHeader p {
    margin: 3px 0;
    color: #fff;
    font-size: 13px;
}

/* LIGHTS */
.lights {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: space-around;
    z-index: 20;
}

.bulb {
    width: 10px;
    height: 10px;
    margin-top: 2px;
    border-radius: 50%;
    background: #ffe66d;
    box-shadow: 0 0 12px #ffe66d;
    animation: bulbGlow 1s infinite alternate;
}

.bulb:nth-child(even) {
    animation-delay: .5s;
}

@keyframes bulbGlow {
    from { opacity: .35; }
    to { opacity: 1; }
}

/* PANDAL */
#pandal {
    position: absolute;
    top: 88px;
    left: 50%;
    transform: translateX(-50%);
    width: 180px;
    height: 105px;
    z-index: 3;
    text-align: center;
}

.pandalRoof {
    width: 180px;
    height: 28px;
    background: linear-gradient(90deg,#f7b733,#ffd96a,#f7b733);
    clip-path: polygon(0 100%, 50% 0, 100% 100%);
}

.pandalBody {
    width: 145px;
    height: 70px;
    margin: auto;
    border-left: 8px solid #f0a83b;
    border-right: 8px solid #f0a83b;
    background: rgba(255,215,100,.15);
}

.ganesha {
    font-size: 48px;
    line-height: 65px;
    filter: drop-shadow(0 0 7px rgba(255,190,50,.7));
}

/* GAME AREA */
#playArea {
    position: absolute;
    left: 0;
    right: 0;
    top: 95px;
    bottom: 100px;
    overflow: hidden;
}

/* ROAD */
#road {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48%;
    background:
        repeating-linear-gradient(
            90deg,
            #3c2655 0px,
            #3c2655 45px,
            #432c5f 45px,
            #432c5f 90px
        );
    border-top: 4px solid #d79c42;
}

#road::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    width: 7px;
    height: 100%;
    transform: translateX(-50%);
    background: repeating-linear-gradient(
        to bottom,
        #f8d36b 0px,
        #f8d36b 30px,
        transparent 30px,
        transparent 65px
    );
    opacity: .7;
}

/* PLAYER */
#player {
    position: absolute;
    left: 50%;
    bottom: 25px;
    width: 62px;
    height: 62px;
    transform: translateX(-50%);
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    filter: drop-shadow(0 4px 5px rgba(0,0,0,.5));
    transition: left .08s linear;
}

#player.shielded {
    filter:
        drop-shadow(0 0 8px #6ee7ff)
        drop-shadow(0 0 15px #6ee7ff);
}

#shieldRing {
    position: absolute;
    width: 70px;
    height: 70px;
    border: 3px solid #66eaff;
    border-radius: 50%;
    box-shadow: 0 0 15px #66eaff;
    animation: shieldPulse .8s infinite alternate;
    display: none;
}

#player.shielded #shieldRing {
    display: block;
}

@keyframes shieldPulse {
    from { transform: scale(.9); opacity: .65; }
    to { transform: scale(1.08); opacity: 1; }
}

/* FALLING OBJECTS */
.fallingObject {
    position: absolute;
    left: 0;
    top: 0;
    width: 52px;
    height: 52px;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 35px;
    will-change: transform;
    pointer-events: none;
}

.fallingObject.item {
    filter: drop-shadow(0 0 7px rgba(255,220,80,.7));
}

.fallingObject.obstacle {
    filter: drop-shadow(0 0 7px rgba(255,90,90,.6));
}

.fallingObject.shield {
    filter: drop-shadow(0 0 9px rgba(80,220,255,.8));
}

/* HUD */
#hud {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 55px;
    z-index: 30;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
}

.hudBox {
    min-width: 90px;
    padding: 7px 11px;
    border-radius: 12px;
    background: rgba(16,7,38,.82);
    border: 1px solid rgba(255,215,90,.65);
    color: white;
    font-size: 13px;
}

.hudBox strong {
    color: #ffd75a;
}

#progressWrap {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 45px;
    height: 6px;
    background: rgba(255,255,255,.18);
    border-radius: 5px;
    overflow: hidden;
    z-index: 29;
}

#progressBar {
    width: 0%;
    height: 100%;
    background: #ffd75a;
    transition: width .2s;
}

/* BUTTONS */
button {
    border: none;
    border-radius: 12px;
    padding: 11px 18px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    background: linear-gradient(135deg,#ffd75a,#f1a52b);
    color: #27102f;
    box-shadow: 0 4px 10px rgba(0,0,0,.3);
}

button:active {
    transform: scale(.96);
}

#pauseBtn,
#soundBtn {
    position: absolute;
    z-index: 40;
    top: 105px;
}

#pauseBtn {
    right: 12px;
}

#soundBtn {
    left: 12px;
}

/* MOBILE CONTROLS */
#mobileControls {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    z-index: 50;
    display: flex;
    justify-content: center;
    gap: 15px;
}

.controlBtn {
    width: 95px;
    height: 43px;
    padding: 5px;
    font-size: 22px;
}

/* OVERLAYS */
.overlay {
    position: absolute;
    inset: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(8,3,25,.78);
    backdrop-filter: blur(4px);
}

.panel {
    width: min(90%, 500px);
    padding: 28px;
    text-align: center;
    border-radius: 22px;
    border: 2px solid #ffd75a;
    background:
        linear-gradient(
            145deg,
            rgba(60,28,100,.96),
            rgba(20,8,48,.97)
        );
    color: white;
    box-shadow: 0 0 35px rgba(255,210,80,.25);
}

.panel h2 {
    margin-top: 0;
    color: #ffd75a;
    font-size: 30px;
}

.panel p {
    line-height: 1.6;
    color: #f7edff;
}

.hidden {
    display: none !important;
}

/* COUNTDOWN */
#countdown {
    position: absolute;
    inset: 0;
    z-index: 90;
    display: none;
    justify-content: center;
    align-items: center;
    font-size: clamp(70px, 16vw, 150px);
    font-weight: bold;
    color: #ffd75a;
    text-shadow: 0 0 30px #ffb300;
}

/* FLOAT SCORE */
.floatScore {
    position: absolute;
    z-index: 70;
    color: #ffe16b;
    font-weight: bold;
    font-size: 20px;
    pointer-events: none;
    animation: floatUp .8s forwards;
}

@keyframes floatUp {
    from {
        opacity: 1;
        transform: translateY(0);
    }
    to {
        opacity: 0;
        transform: translateY(-40px);
    }
}

/* PARTICLES */
.particle {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ffd75a;
    pointer-events: none;
    z-index: 80;
    animation: particleFly .7s forwards;
}

@keyframes particleFly {
    from {
        opacity: 1;
        transform: translate(0,0) scale(1);
    }
    to {
        opacity: 0;
        transform: translate(var(--dx),var(--dy)) scale(.2);
    }
}

@media (max-width: 600px) {
    #gameShell {
        width: 100vw;
        height: 100vh;
        border-width: 2px;
    }

    #pandal {
        transform: translateX(-50%) scale(.8);
        transform-origin: top center;
    }

    .hudBox {
        min-width: auto;
        padding: 5px 7px;
        font-size: 11px;
    }

    #pauseBtn,
    #soundBtn {
        top: 102px;
        padding: 8px 12px;
    }

    .panel {
        padding: 20px;
    }
}
</style>
</head>

<body>

<div id="gameShell">

    <div class="sky">
        <div class="moon"></div>

        <div class="star" style="left:8%;top:18%;">✦</div>
        <div class="star" style="left:18%;top:35%;">✦</div>
        <div class="star" style="left:30%;top:12%;">✦</div>
        <div class="star" style="left:43%;top:28%;">✦</div>
        <div class="star" style="left:61%;top:13%;">✦</div>
        <div class="star" style="left:73%;top:35%;">✦</div>
        <div class="star" style="left:86%;top:17%;">✦</div>

        <div class="cloud" style="left:5%;top:8%;">☁</div>
        <div class="cloud" style="right:18%;top:22%;">☁</div>
    </div>

    <div class="lights">
        <div class="bulb"></div>
        <div class="bulb"></div>
        <div class="bulb"></div>
        <div class="bulb"></div>
        <div class="bulb"></div>
        <div class="bulb"></div>
        <div class="bulb"></div>
        <div class="bulb"></div>
        <div class="bulb"></div>
        <div class="bulb"></div>
        <div class="bulb"></div>
        <div class="bulb"></div>
    </div>

    <div id="festivalHeader">
        <h1>🐘 MUSHak DASH</h1>
        <p>🪔 Grand Ganesh Festival Night 🪔</p>
    </div>

    <div id="pandal">
        <div class="pandalRoof"></div>
        <div class="pandalBody">
            <div class="ganesha">🐘</div>
        </div>
    </div>

    <button id="soundBtn">🔊</button>
    <button id="pauseBtn">⏸ Pause</button>

    <div id="playArea">
        <div id="road"></div>
        <div id="player">
            <div id="shieldRing"></div>
            🐭
        </div>
        <div id="countdown"></div>
    </div>

    <div id="hud">
        <div class="hudBox">⭐ Score: <strong id="score">0</strong></div>
        <div class="hudBox">❤️ Lives: <strong id="lives">3</strong></div>
        <div class="hudBox">🎯 Level: <strong id="level">1</strong></div>
